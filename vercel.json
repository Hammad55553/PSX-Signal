{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/tickers",
      "dest": "main.py"
    },
    {
      "src": "/analyze/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/signal/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/signals",
      "dest": "main.py"
    },
    {
      "src": "/chart/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/symbols",
      "dest": "main.py"
    },
    {
      "src": "/market-recommendations",
      "dest": "main.py"
    },
    {
      "src": "/telegram-config/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/ws/(.*)",
      "dest": "main.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/dist/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "frontend/dist/favicon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    }
  ]
}
